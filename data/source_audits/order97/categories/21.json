        "requirement_id": "21.02-source-trigger",
        "source_blocks": [
          3
        ],
        "summary": "A Surge move requires its granting rule to have triggered.",
        "owners": [
          "src/warhammer40k_core/engine/surge_movement.py:surge_ineligibility"
        ],
        "evidence": [
          {
            "nodeid": "tests/unit/test_order52_surge.py::test_surge_requires_recorded_granting_trigger_before_offer",
            "role": "invalid",
            "assertion": "with pytest.raises(GameLifecycleError, match='recorded trigger authority'):\n    triggered_movement_unit_selection_request(state=state, player_id='player-a', descriptor=descriptor, eligible_units=(TriggeredMovementEligibleUnit(SOURCE, 'hook', descriptor.source_rule_id),))",
            "proves": "Without an authenticated granting trigger no Surge request can be offered."
          }
        ],
        "qualifications": []
      },
      {
        "requirement_id": "21.02-not-battle-shocked",
        "source_blocks": [
          4
        ],
        "summary": "Battle-shocked units cannot Surge.",
