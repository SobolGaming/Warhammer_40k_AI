            "role": "invalid",
            "assertion": "assert resolution.restriction_violations[0].violation_code is TriggeredMovementViolationCode.ENGAGEMENT_RANGE_SURGE_FORBIDDEN",
            "proves": "Enemy engagement yields an explicit Surge restriction."
          }
        ],
        "qualifications": []
      },
