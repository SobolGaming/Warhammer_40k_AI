            "role": "invalid",
            "assertion": "assert resolution.restriction_violations[0].violation_code is TriggeredMovementViolationCode.BATTLE_SHOCKED_SURGE_FORBIDDEN",
            "proves": "The validator identifies Battle-shock as the Surge prohibition."
          }
