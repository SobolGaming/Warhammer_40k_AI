        "source_blocks": [
          1
        ],
        "summary": "A mission objective coinciding with a terrain area uses that area as its objective geometry.",
        "owners": [
          "src/warhammer40k_core/engine/objective_control.py:resolve_objective_control"
        ],
        "evidence": [
          {
            "nodeid": "tests/unit/test_phase11b_objective_control.py::test_terrain_objectives_derive_from_coincident_marker_and_control_area",
            "role": "semantic",
            "assertion": "assert context.terrain_objectives == (Objective.terrain(marker.objective_marker_id, marker.name, terrain_feature.feature_id),)",
            "proves": "Coincident mission marker and area produce a terrain objective."
          }
        ],
        "qualifications": []
      },
