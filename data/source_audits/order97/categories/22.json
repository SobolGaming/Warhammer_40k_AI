        "requirement_id": "22.03-psychic-damage-tag",
        "source_blocks": [
          1
        ],
        "summary": "Wounds caused by a Psychic-tagged ability count as Psychic attack wounds.",
        "owners": [
          "src/warhammer40k_core/engine/mortal_wound_model_allocation.py:mortal_wound_feel_no_pain_sources",
          "src/warhammer40k_core/engine/faction_content/warhammer_40000_11th/thousand_sons/army_rule.py:_resolve_doombolt"
        ],
        "evidence": [
          {
            "nodeid": "tests/unit/test_phase13b_shooting_declarations.py::test_phase13c_mortal_wounds_use_psychic_attack_source_with_mortal_wound_scope",
            "role": "semantic",
            "assertion": "assert application.feel_no_pain_resolutions[0].ignored_wounds == 1",
            "proves": "Psychic-scoped Feel No Pain ignores the marked Psychic mortal wound."
          }
        ],
        "qualifications": [
          "Evidence gap: The actual Cabal Doombolt damage consumer retains a successful Psychic test in source context, but the shared mortal-wound owner has no Psychic classification input and excludes a Psychic-only Feel No Pain source. The retained two-branch probe contrasts an unconditional source with the otherwise identical Psychic-only source. The selected Core clause requires authenticated Psychic ability wounds to count as Psychic attacks; the pinned official Thousand Sons update refers to Doombolt but does not transcribe its own Psychic title, so that named source identity remains unverified. Establish that source evidence and propagate structured damage classification through the shared consumer before certification; the existing attack proof only covers an already-tagged weapon attack."
        ]
      }
    ],
    "nonoperative_blocks": []
