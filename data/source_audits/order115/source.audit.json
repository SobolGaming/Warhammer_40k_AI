  "selected_rows": [
    {
      "row_id": "rule:02:02.02:1",
      "category": "02",
      "locator": "02.02",
      "title": "Profiles",
      "occurrence": 1,
      "source_sha256": "63d7331e78c7d66b7f451704da49555f992ed4128eea23eabb6941d199709588",
      "blocks": [
        {
          "ordinal": 1,
          "kind": "text",
          "sha256": "f914bf47a22eb251158564e246b33a9cce9ac0d2a8c9c53b5c220f3e248f1ed2",
          "value": "These contain the following characteristics that tell you how mighty the models in the unit are:"
        },
        {
          "ordinal": 2,
          "kind": "text",
          "sha256": "b1f2f844b4cb7c3e67c6756b2026df35937d0588d41ba75456cb65f69b475313",
          "value": "\u0005Move (M)\u0006: The speed at which a model traverses the battlefield. If a model has an \u0005M\u0006 characteristic of ‘-’, it can be set up on the battlefield but otherwise cannot be moved."
        },
        {
          "ordinal": 3,
          "kind": "text",
          "sha256": "50fd6ebc100a7d6c4b1bd408a08e541a07f404288dd237be69d25df034e562d9",
          "value": "\u0005Toughness (T)\u0006: The model’s resilience against harm."
        },
        {
          "ordinal": 4,
          "kind": "text",
          "sha256": "686f321decc81baccbb4a6212854e5563b52f1c1ce8f4c749c2a877d2db48d48",
          "value": "\u0005Save (Sv)\u0006: Presented as a dice result (e.g. 4+), this indicates the protection a model’s armour gives it."
        },
        {
          "ordinal": 5,
          "kind": "text",
          "sha256": "3d2712873295af82af21a160b1d563813cc7df19798a2e64083d1b6a42a4f2b5",
          "value": "\u0005Invulnerable Save (InSv)\u0006: Presented as a dice result (e.g. 4+). Some models are protected by esoteric means in addition to physical armour, such as force fields or preternatural reflexes. Not all models have an \u0005InSv\u0006 characteristic, but if they do, it will be listed here."
        },
        {
          "ordinal": 6,
          "kind": "text",
          "sha256": "d576ea4fddaec77271e71d73b961f9dd8142e9eea8cfd8246ef82c7ce131246c",
          "value": "\u0005Wounds (W)\u0006: Wounds represent how much damage a model can sustain before it is \u0005destroyed\u0006. If a model’s wounds are reduced to 0 or fewer, that model is \u0005destroyed\u0006."
        },
        {
          "ordinal": 7,
          "kind": "text",
          "sha256": "b384a7d6965b13c2ab266d2c6d24771a14d0812a1bc7f57336aa8083cdf504a3",
          "value": "\u0005Leadership (Ld)\u0006: Presented as a dice result (e.g. 7+), this reveals how courageous, determined or self‑controlled a model is."
        },
        {
          "ordinal": 8,
          "kind": "text",
          "sha256": "c4762ddec801ac0c25d8ccad25caf7fbaa2c5655b00ae00117b8a6ed9620f349",
          "value": "\u0005Objective Control (OC)\u0006: How effectively a model can control an \u0005objective\u0006 on the battlefield. If a model has an \u0005OC\u0006 characteristic of ‘-’ it is unable to control \u0005objectives\u0006 at all."
        }
      ],
      "selected_provider": "Game Datamissions",
      "historical_source_row_sha256": "0a85b09cb3a9c4feed9d0c3a475e7860422237a1cf0783d30b7840b43f1a1dca",
      "review_category": "02"
    },
    {
