{
  "$id": "https://warhammer40k-core.local/contracts/v3/battlefield-view.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authoritative": {
      "$ref": "#/$defs/authoritative"
    },
    "authoritative_geometry_hash": {
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "battlefield_id": {
      "minLength": 1,
      "type": "string"
    },
    "bounds": {
      "$ref": "#/$defs/bounds"
    },
    "coordinate_space": {
      "const": "battlefield_inches_right_handed_z_up",
      "type": "string"
    },
    "coordinate_spec_version": {
      "const": "battlefield-coordinate-v1",
      "type": "string"
    },
    "interaction": {
      "$ref": "#/$defs/interaction"
    },
    "render": {
      "$ref": "#/$defs/render"
    },
    "schema_version": {
      "const": "battlefield-view-v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "coordinate_spec_version",
    "coordinate_space",
    "battlefield_id",
    "bounds",
    "authoritative_geometry_hash",
    "authoritative",
    "interaction",
    "render"
  ],
  "title": "CORE V2 BattlefieldViewPayload",
  "type": "object",
  "$defs": {
    "authoritative": {
      "additionalProperties": false,
      "properties": {
        "battlefield_regions_by_id": {
          "additionalProperties": {
            "$ref": "#/$defs/battlefield_region"
          },
          "type": "object"
        },
        "deployment_zones_by_id": {
          "additionalProperties": {
            "$ref": "#/$defs/deployment_zone"
          },
          "type": "object"
        },
        "models_by_id": {
          "additionalProperties": {
            "$ref": "#/$defs/model"
          },
          "type": "object"
        },
        "objectives_by_id": {
          "additionalProperties": {
            "$ref": "#/$defs/objective"
          },
          "type": "object"
        },
        "terrain_areas_by_id": {
          "additionalProperties": {
            "$ref": "#/$defs/terrain_area"
          },
          "type": "object"
        },
        "terrain_features_by_id": {
          "additionalProperties": {
            "$ref": "#/$defs/terrain_feature"
          },
          "type": "object"
        }
      },
      "required": [
        "models_by_id",
        "terrain_features_by_id",
        "terrain_areas_by_id",
        "objectives_by_id",
        "deployment_zones_by_id",
        "battlefield_regions_by_id"
      ],
      "type": "object"
    },
    "battlefield_region": {
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "battlefield_region",
          "type": "string"
        },
        "owner_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "region_id": {
          "minLength": 1,
          "type": "string"
        },
        "region_kind": {
          "minLength": 1,
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/region_shape"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "entity_kind",
        "region_id",
        "region_kind",
        "owner_role",
        "shape",
        "source_id"
      ],
      "type": "object"
    },
    "bounds": {
      "additionalProperties": false,
      "properties": {
        "max_x_inches": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "max_y_inches": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "min_x_inches": {
          "const": 0,
          "type": "number"
        },
        "min_y_inches": {
          "const": 0,
          "type": "number"
        },
        "min_z_inches": {
          "const": 0,
          "type": "number"
        }
      },
      "required": [
        "min_x_inches",
        "min_y_inches",
        "min_z_inches",
        "max_x_inches",
        "max_y_inches"
      ],
      "type": "object"
    },
    "candidate_reference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "minLength": 1,
          "type": "string"
        },
        "reference_kind": {
          "const": "decision_option",
          "type": "string"
        }
      },
      "required": [
        "reference_kind",
        "reference_id"
      ],
      "type": "object"
    },
    "deployment_zone": {
      "additionalProperties": false,
      "properties": {
        "deployment_zone_id": {
          "minLength": 1,
          "type": "string"
        },
        "entity_kind": {
          "const": "deployment_zone",
          "type": "string"
        },
        "owner_player_id": {
          "minLength": 1,
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/region_shape"
        }
      },
      "required": [
        "entity_kind",
        "deployment_zone_id",
        "owner_player_id",
        "shape"
      ],
      "type": "object"
    },
    "hit_region": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "minLength": 1,
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        }
      },
      "required": [
        "entity_id",
        "shape"
      ],
      "type": "object"
    },
    "interaction": {
      "additionalProperties": false,
      "properties": {
        "legal_candidate_refs": {
          "items": {
            "$ref": "#/$defs/candidate_reference"
          },
          "type": "array",
          "uniqueItems": true
        },
        "measurement_overlays": {
          "items": {
            "$ref": "#/$defs/measurement_overlay"
          },
          "type": "array",
          "uniqueItems": true
        },
        "path_overlays": {
          "items": {
            "$ref": "#/$defs/path_overlay"
          },
          "type": "array",
          "uniqueItems": true
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_or_acting_entity_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "request_id",
        "selected_or_acting_entity_ids",
        "legal_candidate_refs",
        "measurement_overlays",
        "path_overlays"
      ],
      "type": "object"
    },
    "measurement_overlay": {
      "additionalProperties": false,
      "properties": {
        "distance_inches": {
          "minimum": 0,
          "type": "number"
        },
        "end": {
          "$ref": "#/$defs/position"
        },
        "overlay_id": {
          "minLength": 1,
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/position"
        }
      },
      "required": [
        "overlay_id",
        "start",
        "end",
        "distance_inches"
      ],
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "model",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/model_geometry"
        },
        "model_instance_id": {
          "minLength": 1,
          "type": "string"
        },
        "owner_player_id": {
          "minLength": 1,
          "type": "string"
        },
        "pose": {
          "oneOf": [
            {
              "$ref": "#/$defs/pose"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "placed",
            "destroyed",
            "embarked",
            "reserves",
            "removed",
            "undeployed"
          ],
          "type": "string"
        },
        "state_context": {
          "$ref": "#/$defs/model_state_context"
        },
        "unit_instance_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "entity_kind",
        "model_instance_id",
        "unit_instance_id",
        "owner_player_id",
        "state",
        "pose",
        "geometry",
        "state_context"
      ],
      "type": "object"
    },
    "model_geometry": {
      "additionalProperties": false,
      "properties": {
        "height_inches": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "geometry_source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "geometry_source_kind": {
          "minLength": 1,
          "type": "string"
        },
        "height_source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "height_source_kind": {
          "minLength": 1,
          "type": "string"
        },
        "measurement_basis": {
          "enum": [
            "base",
            "hull"
          ],
          "type": "string"
        },
        "measurement_shapes": {
          "items": {
            "$ref": "#/$defs/shape"
          },
          "minItems": 1,
          "type": "array"
        },
        "support_shape": {
          "$ref": "#/$defs/shape"
        }
      },
      "required": [
        "measurement_basis",
        "measurement_shapes",
        "support_shape",
        "height_inches",
        "geometry_source_kind",
        "geometry_source_id",
        "height_source_kind",
        "height_source_id"
      ],
      "type": "object"
    },
    "model_state_context": {
      "additionalProperties": false,
      "properties": {
        "reserve_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_unit_instance_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "transport_unit_instance_id",
        "reserve_kind"
      ],
      "type": "object"
    },
    "objective": {
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "objective",
          "type": "string"
        },
        "marker_diameter_inches": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "measurement_anchor": {
          "minLength": 1,
          "type": "string"
        },
        "objective_id": {
          "minLength": 1,
          "type": "string"
        },
        "objective_role": {
          "minLength": 1,
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "entity_kind",
        "objective_id",
        "objective_role",
        "position",
        "marker_diameter_inches",
        "measurement_anchor",
        "source_id"
      ],
      "type": "object"
    },
    "path_overlay": {
      "additionalProperties": false,
      "properties": {
        "model_instance_id": {
          "minLength": 1,
          "type": "string"
        },
        "overlay_id": {
          "minLength": 1,
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/path_segment"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "overlay_id",
        "model_instance_id",
        "segments"
      ],
      "type": "object"
    },
    "path_segment": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/pose"
        },
        "segment_kind": {
          "const": "line",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/pose"
        }
      },
      "required": [
        "segment_kind",
        "start",
        "end"
      ],
      "type": "object"
    },
    "point": {
      "additionalProperties": false,
      "properties": {
        "x_inches": {
          "type": "number"
        },
        "y_inches": {
          "type": "number"
        }
      },
      "required": [
        "x_inches",
        "y_inches"
      ],
      "type": "object"
    },
    "polygon": {
      "items": {
        "$ref": "#/$defs/point"
      },
      "minItems": 3,
      "type": "array"
    },
    "pose": {
      "additionalProperties": false,
      "properties": {
        "facing_degrees": {
          "minimum": 0,
          "exclusiveMaximum": 360,
          "type": "number"
        },
        "position": {
          "$ref": "#/$defs/position"
        }
      },
      "required": [
        "position",
        "facing_degrees"
      ],
      "type": "object"
    },
    "position": {
      "additionalProperties": false,
      "properties": {
        "x_inches": {
          "type": "number"
        },
        "y_inches": {
          "type": "number"
        },
        "z_inches": {
          "type": "number"
        }
      },
      "required": [
        "x_inches",
        "y_inches",
        "z_inches"
      ],
      "type": "object"
    },
    "region_shape": {
      "additionalProperties": false,
      "properties": {
        "circle_cutouts": {
          "items": {
            "$ref": "#/$defs/shape"
          },
          "type": "array"
        },
        "polygon_cutouts": {
          "items": {
            "$ref": "#/$defs/shape"
          },
          "type": "array"
        },
        "polygons": {
          "items": {
            "$ref": "#/$defs/polygon"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "polygons",
        "circle_cutouts",
        "polygon_cutouts"
      ],
      "type": "object"
    },
    "render": {
      "additionalProperties": false,
      "properties": {
        "hints_by_entity_id": {
          "additionalProperties": {
            "$ref": "#/$defs/render_hint"
          },
          "type": "object"
        },
        "hit_regions_by_entity_id": {
          "additionalProperties": {
            "$ref": "#/$defs/hit_region"
          },
          "type": "object"
        }
      },
      "required": [
        "hit_regions_by_entity_id",
        "hints_by_entity_id"
      ],
      "type": "object"
    },
    "render_hint": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "asset_id"
      ],
      "type": "object"
    },
    "shape": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "circle"
              }
            }
          },
          "then": {
            "properties": {
              "length_inches": {
                "type": "null"
              },
              "radius_inches": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "vertices": {
                "maxItems": 0
              },
              "width_inches": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "ellipse",
                  "rectangle"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "length_inches": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "radius_inches": {
                "type": "null"
              },
              "vertices": {
                "maxItems": 0
              },
              "width_inches": {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "polygon"
              }
            }
          },
          "then": {
            "properties": {
              "center": {
                "type": "null"
              },
              "length_inches": {
                "type": "null"
              },
              "radius_inches": {
                "type": "null"
              },
              "vertices": {
                "$ref": "#/$defs/polygon"
              },
              "width_inches": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "center": {
          "oneOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "circle",
            "ellipse",
            "rectangle",
            "polygon"
          ],
          "type": "string"
        },
        "length_inches": {
          "type": [
            "number",
            "null"
          ]
        },
        "radius_inches": {
          "type": [
            "number",
            "null"
          ]
        },
        "rotation_degrees": {
          "minimum": 0,
          "exclusiveMaximum": 360,
          "type": "number"
        },
        "vertices": {
          "items": {
            "$ref": "#/$defs/point"
          },
          "type": "array"
        },
        "width_inches": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "center",
        "rotation_degrees",
        "radius_inches",
        "length_inches",
        "width_inches",
        "vertices"
      ],
      "type": "object"
    },
    "terrain_area": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "minLength": 1,
          "type": "string"
        },
        "entity_kind": {
          "const": "terrain_area",
          "type": "string"
        },
        "footprint": {
          "$ref": "#/$defs/shape"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "terrain_area_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "entity_kind",
        "terrain_area_id",
        "classification",
        "footprint",
        "source_id"
      ],
      "type": "object"
    },
    "terrain_feature": {
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "terrain_feature",
          "type": "string"
        },
        "footprint": {
          "$ref": "#/$defs/shape"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "terrain_feature_id": {
          "minLength": 1,
          "type": "string"
        },
        "terrain_feature_kind": {
          "minLength": 1,
          "type": "string"
        },
        "volumes": {
          "items": {
            "$ref": "#/$defs/volume"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "entity_kind",
        "terrain_feature_id",
        "terrain_feature_kind",
        "footprint",
        "volumes",
        "source_id"
      ],
      "type": "object"
    },
    "volume": {
      "additionalProperties": false,
      "properties": {
        "bottom_center": {
          "$ref": "#/$defs/position"
        },
        "depth_inches": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "height_inches": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "rotation_degrees": {
          "minimum": 0,
          "exclusiveMaximum": 360,
          "type": "number"
        },
        "volume_id": {
          "minLength": 1,
          "type": "string"
        },
        "volume_kind": {
          "enum": [
            "wall",
            "floor"
          ],
          "type": "string"
        },
        "width_inches": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "volume_id",
        "volume_kind",
        "bottom_center",
        "width_inches",
        "depth_inches",
        "height_inches",
        "rotation_degrees"
      ],
      "type": "object"
    }
  }
}
