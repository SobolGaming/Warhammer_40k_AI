{
  "$id": "https://warhammer40k-core.local/contracts/v7/replay-metadata.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {"minLength": 1, "type": "string"},
    "decision_records": {"items": {"type": "object"}, "type": "array"},
    "event_records": {"items": {"type": "object"}, "type": "array"},
    "initial_lifecycle": {
      "additionalProperties": true,
      "properties": {
        "config": {
          "$ref": "https://warhammer40k-core.local/contracts/v3/create-session.schema.json#/properties/config"
        },
        "state": {"$ref": "#/$defs/step4_replay_state"}
      },
      "required": ["config", "state"],
      "type": "object"
    },
    "initial_rng_state": {"type": "object"},
    "projection_checkpoints": {
      "items": {"$ref": "#/$defs/projection_checkpoint"},
      "type": "array"
    },
    "schema_version": {"const": "replay-artifact-v7-phase17n-step4", "type": "string"},
    "source_identity": {"$ref": "#/$defs/source_identity"}
  },
  "required": [
    "schema_version",
    "artifact_id",
    "source_identity",
    "initial_rng_state",
    "initial_lifecycle",
    "decision_records",
    "event_records",
    "projection_checkpoints"
  ],
  "title": "CORE V2 ReplayArtifactMetadataPayload",
  "type": "object",
  "$defs": {
    "step4_replay_state": {
      "additionalProperties": true,
      "description": "The Contract 9 schema-owned Phase 17N Step 4 evidence and persistent mission-state slice. Other lifecycle state remains engine-private and is validated by the fail-closed replay loader.",
      "properties": {
        "mission_action_states": {
          "items": {"$ref": "#/$defs/mission_action_state"},
          "type": "array",
          "uniqueItems": true
        },
        "primary_battlefield_departure_states": {
          "items": {"$ref": "#/$defs/primary_battlefield_departure_state"},
          "type": "array"
        },
        "primary_rules_unit_turn_start_snapshots": {
          "items": {
            "$ref": "https://warhammer40k-core.local/contracts/v8/game-view.schema.json#/$defs/primary_rules_unit_turn_start_snapshot"
          },
          "type": "array"
        },
        "primary_mission_progress_state": {
          "$ref": "https://warhammer40k-core.local/contracts/v8/game-view.schema.json#/$defs/primary_mission_progress_state"
        },
        "primary_unit_destruction_states": {
          "items": {"$ref": "#/$defs/primary_unit_destruction_state"},
          "type": "array"
        }
      },
      "required": [
        "mission_action_states",
        "primary_rules_unit_turn_start_snapshots",
        "primary_unit_destruction_states",
        "primary_battlefield_departure_states",
        "primary_mission_progress_state"
      ],
      "type": "object"
    },
    "mission_action_state": {
      "additionalProperties": false,
      "properties": {
        "action_id": {"minLength": 1, "type": "string"},
        "mission_action_id": {"minLength": 1, "type": "string"},
        "player_id": {"minLength": 1, "type": "string"},
        "unit_instance_id": {"minLength": 1, "type": "string"},
        "target_id": {"minLength": 1, "type": "string"},
        "condition_target_id": {"$ref": "#/$defs/nullable_identifier"},
        "mission_id": {"minLength": 1, "type": "string"},
        "battle_round_started": {"minimum": 1, "type": "integer"},
        "phase_started": {"minLength": 1, "type": "string"},
        "start_timing": {"minLength": 1, "type": "string"},
        "completion_timing": {"minLength": 1, "type": "string"},
        "eligible_unit_instance_ids": {
          "items": {"minLength": 1, "type": "string"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "interruption_conditions": {"$ref": "#/$defs/identifier_array"},
        "scoring_source_id": {"minLength": 1, "type": "string"},
        "victory_points": {"minimum": 0, "type": "integer"},
        "status": {
          "enum": ["started", "completed", "interrupted"],
          "type": "string"
        },
        "completed_battle_round": {
          "oneOf": [
            {"minimum": 1, "type": "integer"},
            {"type": "null"}
          ]
        },
        "completed_phase": {"$ref": "#/$defs/nullable_identifier"},
        "interrupted_reason": {"$ref": "#/$defs/nullable_identifier"},
        "score_transaction_id": {"$ref": "#/$defs/nullable_identifier"}
      },
      "required": [
        "action_id",
        "mission_action_id",
        "player_id",
        "unit_instance_id",
        "target_id",
        "condition_target_id",
        "mission_id",
        "battle_round_started",
        "phase_started",
        "start_timing",
        "completion_timing",
        "eligible_unit_instance_ids",
        "interruption_conditions",
        "scoring_source_id",
        "victory_points",
        "status",
        "completed_battle_round",
        "completed_phase",
        "interrupted_reason",
        "score_transaction_id"
      ],
      "type": "object"
    },
    "identifier_array": {
      "items": {"minLength": 1, "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "nullable_identifier": {
      "oneOf": [
        {"minLength": 1, "type": "string"},
        {"type": "null"}
      ]
    },
    "objective_marker_model_witness": {
      "additionalProperties": false,
      "properties": {
        "model_instance_ids": {
          "items": {"minLength": 1, "type": "string"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "objective_marker_id": {"minLength": 1, "type": "string"}
      },
      "required": ["objective_marker_id", "model_instance_ids"],
      "type": "object"
    },
    "rules_unit_objective_proximity_witness": {
      "additionalProperties": false,
      "properties": {
        "component_unit_instance_ids": {
          "items": {"minLength": 1, "type": "string"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "objective_marker_witnesses": {
          "items": {"$ref": "#/$defs/objective_marker_model_witness"},
          "type": "array",
          "uniqueItems": true
        },
        "rules_unit_instance_id": {"minLength": 1, "type": "string"}
      },
      "required": [
        "rules_unit_instance_id",
        "component_unit_instance_ids",
        "objective_marker_witnesses"
      ],
      "type": "object"
    },
    "destruction_provenance": {
      "additionalProperties": false,
      "properties": {
        "attack_context_id": {"$ref": "#/$defs/nullable_identifier"},
        "attack_kind": {"enum": ["melee", "ranged", "none"], "type": "string"},
        "destruction_source_kind": {
          "enum": ["attack", "deadly_demise", "hazardous", "ability"],
          "type": "string"
        },
        "source_weapon_profile": {
          "oneOf": [
            {"minProperties": 1, "type": "object"},
            {"type": "null"}
          ]
        }
      },
      "required": [
        "destruction_source_kind",
        "attack_kind",
        "source_weapon_profile",
        "attack_context_id"
      ],
      "type": "object"
    },
    "model_destruction_attribution": {
      "additionalProperties": false,
      "properties": {
        "attacking_model_instance_id": {"$ref": "#/$defs/nullable_identifier"},
        "attacking_unit_instance_id": {"$ref": "#/$defs/nullable_identifier"},
        "destroying_player_id": {"minLength": 1, "type": "string"},
        "destruction_provenance": {"$ref": "#/$defs/destruction_provenance"},
        "source_model_instance_id": {"$ref": "#/$defs/nullable_identifier"},
        "source_rules_unit_instance_id": {"$ref": "#/$defs/nullable_identifier"}
      },
      "required": [
        "destroying_player_id",
        "source_rules_unit_instance_id",
        "source_model_instance_id",
        "attacking_unit_instance_id",
        "attacking_model_instance_id",
        "destruction_provenance"
      ],
      "type": "object"
    },
    "primary_unit_destruction_state": {
      "additionalProperties": false,
      "properties": {
        "active_player_id": {"minLength": 1, "type": "string"},
        "battle_round": {"minimum": 1, "type": "integer"},
        "destroyed_player_id": {"minLength": 1, "type": "string"},
        "destroyed_unit_instance_id": {"minLength": 1, "type": "string"},
        "destroying_player_id": {"$ref": "#/$defs/nullable_identifier"},
        "destruction_attribution": {
          "oneOf": [
            {"$ref": "#/$defs/model_destruction_attribution"},
            {"type": "null"}
          ]
        },
        "destruction_id": {"minLength": 1, "type": "string"},
        "game_id": {"minLength": 1, "type": "string"},
        "phase": {"minLength": 1, "type": "string"},
        "source_battlefield_departure_ids": {"$ref": "#/$defs/identifier_array"},
        "source_id": {"minLength": 1, "type": "string"},
        "source_model_destroyed_event_id": {"$ref": "#/$defs/nullable_identifier"},
        "source_mutation_id": {"$ref": "#/$defs/nullable_identifier"},
        "source_rules_unit_objective_proximity_witness": {
          "oneOf": [
            {"$ref": "#/$defs/rules_unit_objective_proximity_witness"},
            {"type": "null"}
          ]
        },
        "started_turn_objective_marker_ids": {"$ref": "#/$defs/identifier_array"},
        "started_turn_terrain_feature_ids": {"$ref": "#/$defs/identifier_array"},
        "unattributed_cause": {
          "oneOf": [
            {
              "enum": [
                "desperate_escape",
                "emergency_disembark",
                "unit_coherency",
                "reserve_deadline"
              ],
              "type": "string"
            },
            {"type": "null"}
          ]
        }
      },
      "required": [
        "destruction_id",
        "game_id",
        "destroying_player_id",
        "destruction_attribution",
        "source_model_destroyed_event_id",
        "source_rules_unit_objective_proximity_witness",
        "source_battlefield_departure_ids",
        "unattributed_cause",
        "source_mutation_id",
        "destroyed_player_id",
        "active_player_id",
        "battle_round",
        "phase",
        "destroyed_unit_instance_id",
        "started_turn_terrain_feature_ids",
        "started_turn_objective_marker_ids",
        "source_id"
      ],
      "type": "object"
    },
    "primary_battlefield_departure_state": {
      "additionalProperties": false,
      "properties": {
        "active_player_id": {"minLength": 1, "type": "string"},
        "affected_component_unit_instance_ids": {"$ref": "#/$defs/identifier_array"},
        "battle_round": {"minimum": 1, "type": "integer"},
        "component_unit_instance_ids": {"$ref": "#/$defs/identifier_array"},
        "departed_component_unit_instance_ids": {"$ref": "#/$defs/identifier_array"},
        "departure_id": {"minLength": 1, "type": "string"},
        "game_id": {"minLength": 1, "type": "string"},
        "occurrence_id": {"minLength": 1, "type": "string"},
        "owner_player_id": {"minLength": 1, "type": "string"},
        "phase": {"minLength": 1, "type": "string"},
        "removal_kind": {
          "enum": ["destroyed", "embark", "into_reserves", "temporarily_removed"],
          "type": "string"
        },
        "removed_model_instance_ids": {"$ref": "#/$defs/identifier_array"},
        "rules_unit_instance_id": {"minLength": 1, "type": "string"},
        "source_id": {"minLength": 1, "type": "string"}
      },
      "required": [
        "departure_id",
        "game_id",
        "owner_player_id",
        "rules_unit_instance_id",
        "component_unit_instance_ids",
        "affected_component_unit_instance_ids",
        "departed_component_unit_instance_ids",
        "removed_model_instance_ids",
        "battle_round",
        "active_player_id",
        "phase",
        "removal_kind",
        "occurrence_id",
        "source_id"
      ],
      "type": "object"
    },
    "projection_checkpoint": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {"minLength": 1, "type": "string"},
        "decision_record_index": {"minimum": 0, "type": "integer"},
        "event_count": {"minimum": 0, "type": "integer"},
        "event_log_hash": {"minLength": 64, "type": "string"},
        "projection_schema": {"minLength": 1, "type": "string"},
        "projection_state_hash": {"minLength": 1, "type": "string"},
        "viewer_player_id": {"minLength": 1, "type": "string"}
      },
      "required": [
        "checkpoint_id",
        "decision_record_index",
        "event_count",
        "event_log_hash",
        "viewer_player_id",
        "projection_schema",
        "projection_state_hash"
      ],
      "type": "object"
    },
    "source_identity": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "mission_pack_id": {"type": "null"},
                "mission_source_package_hash": {"type": "null"}
              }
            },
            {
              "properties": {
                "mission_pack_id": {"minLength": 1, "type": "string"},
                "mission_source_package_hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "catalog_hash": {"minLength": 64, "type": "string"},
        "catalog_id": {"minLength": 1, "type": "string"},
        "game_config_hash": {"minLength": 64, "type": "string"},
        "game_id": {"minLength": 1, "type": "string"},
        "ruleset_descriptor_hash": {"minLength": 64, "type": "string"},
        "rules_overlay_ids": {
          "items": {"minLength": 1, "type": "string"},
          "type": "array",
          "uniqueItems": true
        },
        "source_ids": {"items": {"type": "string"}, "type": "array"},
        "source_package_id": {"minLength": 1, "type": "string"},
        "mission_pack_id": {"type": ["string", "null"]},
        "mission_source_package_hash": {"type": ["string", "null"]}
      },
      "required": [
        "game_id",
        "game_config_hash",
        "ruleset_descriptor_hash",
        "rules_overlay_ids",
        "catalog_id",
        "catalog_hash",
        "source_package_id",
        "source_ids",
        "mission_pack_id",
        "mission_source_package_hash"
      ],
      "type": "object"
    }
  }
}
