{
  "$id": "https://warhammer40k-core.local/contracts/v8/game-view.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_player_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "battle_round": {
      "minimum": 0,
      "type": "integer"
    },
    "battlefield_state": {
      "$ref": "#/$defs/json_value"
    },
    "battlefield_view": {
      "oneOf": [
        {
          "$ref": "https://warhammer40k-core.local/contracts/v6/battlefield-view.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_battle_phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_setup_step": {
      "type": [
        "string",
        "null"
      ]
    },
    "game_id": {
      "minLength": 1,
      "type": "string"
    },
    "mission_setup": {
      "$ref": "https://warhammer40k-core.local/contracts/v3/create-session.schema.json#/properties/config/properties/mission_setup"
    },
    "model_display_by_id": {
      "additionalProperties": {
        "$ref": "#/$defs/model_display"
      },
      "type": "object"
    },
    "pending_decision": {
      "oneOf": [
        {
          "$ref": "https://warhammer40k-core.local/contracts/v6/decision-request-view.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_proposal": {
      "$ref": "#/$defs/json_value"
    },
    "nested_interaction_requests": {
      "items": {
        "$ref": "https://warhammer40k-core.local/contracts/v4/annotated-decision-request.schema.json"
      },
      "type": "array",
      "uniqueItems": true
    },
    "player_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "projection_schema": {
      "const": "game-view-v11-phase17n-step4",
      "minLength": 1,
      "type": "string"
    },
    "projection_state_hash": {
      "minLength": 1,
      "type": "string"
    },
    "public_command_point_ledgers": {
      "items": {
        "$ref": "#/$defs/json_value"
      },
      "type": "array"
    },
    "public_secondary_mission_card_states": {
      "items": {
        "$ref": "#/$defs/json_value"
      },
      "type": "array"
    },
    "public_secondary_mission_choices": {
      "items": {
        "$ref": "#/$defs/json_value"
      },
      "type": "array"
    },
    "primary_rules_unit_turn_start_snapshots": {
      "items": {
        "$ref": "#/$defs/primary_rules_unit_turn_start_snapshot"
      },
      "type": "array",
      "uniqueItems": true
    },
    "primary_mission_progress_state": {
      "$ref": "#/$defs/primary_mission_progress_state"
    },
    "public_stratagem_use_records": {
      "items": {
        "$ref": "#/$defs/json_value"
      },
      "type": "array"
    },
    "public_victory_point_ledgers": {
      "items": {
        "$ref": "#/$defs/json_value"
      },
      "type": "array"
    },
    "rules_catalog": {
      "$ref": "#/$defs/rules_catalog_reference"
    },
    "stage": {
      "minLength": 1,
      "type": "string"
    },
    "unit_display_by_id": {
      "additionalProperties": {
        "$ref": "#/$defs/unit_display"
      },
      "type": "object"
    },
    "viewer_player_id": {
      "oneOf": [
        {"minLength": 1, "type": "string"},
        {"type": "null"}
      ]
    },
    "viewer_role": {
      "enum": ["player", "coach", "delayed_spectator", "administrator"],
      "type": "string"
    }
  },
  "required": [
    "projection_schema",
    "projection_state_hash",
    "rules_catalog",
    "viewer_role",
    "viewer_player_id",
    "game_id",
    "stage",
    "battle_round",
    "active_player_id",
    "current_setup_step",
    "current_battle_phase",
    "player_ids",
    "battlefield_state",
    "mission_setup",
    "public_secondary_mission_choices",
    "public_secondary_mission_card_states",
    "primary_rules_unit_turn_start_snapshots",
    "primary_mission_progress_state",
    "public_command_point_ledgers",
    "public_victory_point_ledgers",
    "public_stratagem_use_records",
    "unit_display_by_id",
    "model_display_by_id",
    "pending_decision",
    "pending_proposal",
    "nested_interaction_requests"
  ],
  "title": "CORE V2 GameViewPayload",
  "type": "object",
  "$defs": {
    "base_size": {
      "additionalProperties": false,
      "properties": {
        "base_size_id": {
          "minLength": 1,
          "type": "string"
        },
        "diameter_mm": {
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "length_mm": {
          "type": [
            "number",
            "null"
          ]
        },
        "width_mm": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "base_size_id",
        "kind",
        "diameter_mm",
        "length_mm",
        "width_mm"
      ],
      "type": "object"
    },
    "characteristic": {
      "additionalProperties": true,
      "properties": {
        "applied_modifier_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "display_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "final": {
          "type": [
            "integer",
            "null"
          ]
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "redaction": {
          "$ref": "#/$defs/redaction"
        }
      },
      "required": [
        "label",
        "final",
        "display_value",
        "applied_modifier_ids",
        "redaction"
      ],
      "type": "object"
    },
    "json_value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/json_value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          },
          "type": "object"
        }
      ]
    },
    "model_display": {
      "additionalProperties": true,
      "properties": {
        "base_characteristics": {
          "additionalProperties": {
            "$ref": "#/$defs/characteristic"
          },
          "type": "object"
        },
        "base_size": {
          "oneOf": [
            {
              "$ref": "#/$defs/base_size"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_characteristics": {
          "additionalProperties": {
            "$ref": "#/$defs/characteristic"
          },
          "type": "object"
        },
        "model_instance_id": {
          "minLength": 1,
          "type": "string"
        },
        "model_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "redaction": {
          "$ref": "#/$defs/redaction"
        },
        "unit_instance_id": {
          "minLength": 1,
          "type": "string"
        },
        "visible_modifiers": {
          "items": {
            "$ref": "#/$defs/json_value"
          },
          "type": "array"
        },
        "wargear_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "model_instance_id",
        "unit_instance_id",
        "model_profile_id",
        "wargear_ids",
        "base_size",
        "base_characteristics",
        "current_characteristics",
        "visible_modifiers",
        "redaction"
      ],
      "type": "object"
    },
    "primary_rules_unit_turn_start_snapshot": {
      "additionalProperties": false,
      "properties": {
        "active_player_id": {
          "minLength": 1,
          "type": "string"
        },
        "battle_round": {
          "minimum": 1,
          "type": "integer"
        },
        "game_id": {
          "minLength": 1,
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "rules_unit_memberships": {
          "items": {
            "$ref": "#/$defs/primary_rules_unit_turn_start_membership"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "snapshot_id",
        "game_id",
        "active_player_id",
        "battle_round",
        "rules_unit_memberships",
        "source_id"
      ],
      "type": "object"
    },
    "primary_rules_unit_turn_start_membership": {
      "additionalProperties": false,
      "properties": {
        "component_memberships": {
          "items": {
            "$ref": "#/$defs/primary_component_turn_start_membership"
          },
          "type": "array",
          "uniqueItems": true
        },
        "rules_unit_instance_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "rules_unit_instance_id",
        "component_memberships"
      ],
      "type": "object"
    },
    "primary_component_turn_start_membership": {
      "additionalProperties": false,
      "properties": {
        "evaluated_model_instance_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "logical_terrain_area_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "objective_marker_witnesses": {
          "items": {
            "$ref": "#/$defs/primary_objective_marker_witness"
          },
          "type": "array",
          "uniqueItems": true
        },
        "unit_instance_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "unit_instance_id",
        "evaluated_model_instance_ids",
        "logical_terrain_area_ids",
        "objective_marker_witnesses"
      ],
      "type": "object"
    },
    "primary_objective_marker_witness": {
      "additionalProperties": false,
      "properties": {
        "model_instance_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "objective_marker_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "objective_marker_id",
        "model_instance_ids"
      ],
      "type": "object"
    },
    "primary_mission_progress_state": {
      "additionalProperties": false,
      "properties": {
        "markers": {
          "items": {"$ref": "#/$defs/primary_mission_marker_state"},
          "type": "array",
          "uniqueItems": true
        },
        "condemned_selections": {
          "items": {"$ref": "#/$defs/primary_condemned_selection_state"},
          "type": "array",
          "uniqueItems": true
        },
        "consecration_designations": {
          "items": {"$ref": "#/$defs/primary_consecration_designation_state"},
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "markers",
        "condemned_selections",
        "consecration_designations"
      ],
      "type": "object"
    },
    "primary_mission_marker_state": {
      "additionalProperties": false,
      "properties": {
        "marker_id": {"minLength": 1, "type": "string"},
        "game_id": {"minLength": 1, "type": "string"},
        "owner_player_id": {"minLength": 1, "type": "string"},
        "mission_id": {"minLength": 1, "type": "string"},
        "source_rule_id": {"minLength": 1, "type": "string"},
        "source_descriptor_id": {"minLength": 1, "type": "string"},
        "marker_kind": {"minLength": 1, "type": "string"},
        "anchor_kind": {
          "enum": ["objective", "terrain_feature"],
          "type": "string"
        },
        "objective_marker_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "terrain_feature_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "created_battle_round": {"$ref": "#/$defs/primary_nullable_positive_integer"},
        "created_phase": {"$ref": "#/$defs/primary_nullable_identifier"},
        "created_active_player_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "source_event_id": {"minLength": 1, "type": "string"},
        "source_result_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "source_action_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "source_destruction_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "source_designation_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "status": {"enum": ["active", "removed"], "type": "string"},
        "removed_battle_round": {"$ref": "#/$defs/primary_nullable_positive_integer"},
        "removed_phase": {"$ref": "#/$defs/primary_nullable_identifier"},
        "removed_active_player_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "removal_source_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "removal_event_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "removal_result_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "removal_action_id": {"$ref": "#/$defs/primary_nullable_identifier"}
      },
      "required": [
        "marker_id",
        "game_id",
        "owner_player_id",
        "mission_id",
        "source_rule_id",
        "source_descriptor_id",
        "marker_kind",
        "anchor_kind",
        "objective_marker_id",
        "terrain_feature_id",
        "created_battle_round",
        "created_phase",
        "created_active_player_id",
        "source_event_id",
        "source_result_id",
        "source_action_id",
        "source_destruction_id",
        "source_designation_id",
        "status",
        "removed_battle_round",
        "removed_phase",
        "removed_active_player_id",
        "removal_source_id",
        "removal_event_id",
        "removal_result_id",
        "removal_action_id"
      ],
      "type": "object"
    },
    "primary_condemned_selection_state": {
      "additionalProperties": false,
      "properties": {
        "selection_id": {"minLength": 1, "type": "string"},
        "game_id": {"minLength": 1, "type": "string"},
        "owner_player_id": {"minLength": 1, "type": "string"},
        "mission_id": {"minLength": 1, "type": "string"},
        "source_rule_id": {"minLength": 1, "type": "string"},
        "source_descriptor_id": {"minLength": 1, "type": "string"},
        "battle_round": {"minimum": 1, "type": "integer"},
        "active_player_id": {"minLength": 1, "type": "string"},
        "candidate_policy_id": {"minLength": 1, "type": "string"},
        "candidate_rules_unit_instance_ids": {
          "$ref": "#/$defs/primary_identifier_array"
        },
        "candidate_evidence_ids": {"$ref": "#/$defs/primary_identifier_array"},
        "selected_rules_unit_instance_ids": {
          "$ref": "#/$defs/primary_identifier_array"
        },
        "minimum_selection_count": {"minimum": 0, "type": "integer"},
        "maximum_selection_count": {"minimum": 0, "type": "integer"},
        "used_fallback_candidates": {"type": "boolean"},
        "selection_request_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "selection_result_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "source_event_id": {"minLength": 1, "type": "string"}
      },
      "required": [
        "selection_id",
        "game_id",
        "owner_player_id",
        "mission_id",
        "source_rule_id",
        "source_descriptor_id",
        "battle_round",
        "active_player_id",
        "candidate_policy_id",
        "candidate_rules_unit_instance_ids",
        "candidate_evidence_ids",
        "selected_rules_unit_instance_ids",
        "minimum_selection_count",
        "maximum_selection_count",
        "used_fallback_candidates",
        "selection_request_id",
        "selection_result_id",
        "source_event_id"
      ],
      "type": "object"
    },
    "primary_consecration_designation_state": {
      "additionalProperties": false,
      "properties": {
        "designation_id": {"minLength": 1, "type": "string"},
        "game_id": {"minLength": 1, "type": "string"},
        "owner_player_id": {"minLength": 1, "type": "string"},
        "mission_id": {"minLength": 1, "type": "string"},
        "source_rule_id": {"minLength": 1, "type": "string"},
        "source_descriptor_id": {"minLength": 1, "type": "string"},
        "rules_unit_instance_id": {"minLength": 1, "type": "string"},
        "component_unit_instance_ids": {"$ref": "#/$defs/primary_identifier_array"},
        "source_destruction_id": {"minLength": 1, "type": "string"},
        "created_battle_round": {"minimum": 1, "type": "integer"},
        "created_phase": {"minLength": 1, "type": "string"},
        "created_active_player_id": {"minLength": 1, "type": "string"},
        "source_event_id": {"minLength": 1, "type": "string"},
        "last_resolved_battle_round": {
          "$ref": "#/$defs/primary_nullable_positive_integer"
        },
        "last_resolved_active_player_id": {
          "$ref": "#/$defs/primary_nullable_identifier"
        },
        "last_resolution_event_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "last_resolution_result_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "status": {"enum": ["active", "consumed"], "type": "string"},
        "consumed_marker_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "consumed_battle_round": {"$ref": "#/$defs/primary_nullable_positive_integer"},
        "consumed_phase": {"$ref": "#/$defs/primary_nullable_identifier"},
        "consumed_active_player_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "consumption_source_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "consumption_event_id": {"$ref": "#/$defs/primary_nullable_identifier"},
        "consumption_result_id": {"$ref": "#/$defs/primary_nullable_identifier"}
      },
      "required": [
        "designation_id",
        "game_id",
        "owner_player_id",
        "mission_id",
        "source_rule_id",
        "source_descriptor_id",
        "rules_unit_instance_id",
        "component_unit_instance_ids",
        "source_destruction_id",
        "created_battle_round",
        "created_phase",
        "created_active_player_id",
        "source_event_id",
        "last_resolved_battle_round",
        "last_resolved_active_player_id",
        "last_resolution_event_id",
        "last_resolution_result_id",
        "status",
        "consumed_marker_id",
        "consumed_battle_round",
        "consumed_phase",
        "consumed_active_player_id",
        "consumption_source_id",
        "consumption_event_id",
        "consumption_result_id"
      ],
      "type": "object"
    },
    "primary_identifier_array": {
      "items": {"minLength": 1, "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "primary_nullable_identifier": {
      "oneOf": [
        {"minLength": 1, "type": "string"},
        {"type": "null"}
      ]
    },
    "primary_nullable_positive_integer": {
      "oneOf": [
        {"minimum": 1, "type": "integer"},
        {"type": "null"}
      ]
    },
    "redaction": {
      "additionalProperties": false,
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hidden",
        "reason"
      ],
      "type": "object"
    },
    "rules_catalog_reference": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "minLength": 1,
          "type": "string"
        },
        "projection_schema": {
          "const": "rules-catalog-view-v2",
          "minLength": 1,
          "type": "string"
        },
        "ruleset_id": {
          "$ref": "#/$defs/json_value"
        },
        "source_hash": {
          "minLength": 64,
          "type": "string"
        },
        "source_package_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "projection_schema",
        "catalog_id",
        "ruleset_id",
        "source_package_id",
        "source_hash"
      ],
      "type": "object"
    },
    "unit_display": {
      "additionalProperties": true,
      "properties": {
        "datasheet_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_instance_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "owner_player_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "redaction": {
          "$ref": "#/$defs/redaction"
        },
        "unit_instance_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "unit_instance_id",
        "owner_player_id",
        "datasheet_id",
        "model_instance_ids",
        "redaction"
      ],
      "type": "object"
    }
  }
}
