{
  "artifact_schema": "core-v2-core-aircraft-source-v1",
  "source_package_id": "gw-11e-core-aircraft",
  "source_version": "maintained-app-mirrors-observed-2026-09-20",
  "rules": [
    {
      "source_id": "gw-11e-core-aircraft:deployment",
      "section_id": "23.01",
      "source_text": "In the Declare Battle Formations step, all AIRCRAFT units must be placed in strategic reserves (20.01).",
      "transcription_sha256": "0121fe485981e9ddb6ddd73733ee09d133ba4b1f5e67e7909847ef5134b680e6",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.reserve_declarations:apply_mandatory_aircraft_reserve_declarations"
      ]
    },
    {
      "source_id": "gw-11e-core-aircraft:movement",
      "section_id": "23.02",
      "source_text": "AIRCRAFT units are only eligible to make an ingress move (20.04); they are not eligible to make any other type of move. At the end of your opponent’s turn, all AIRCRAFT units in your army that are on the battlefield must be placed in strategic reserves. Each time a unit makes any type of move, its models can be moved through AIRCRAFT models. Each time a unit makes a pile-in, consolidation or surge move, unless that unit can FLY, while making that move, ignore AIRCRAFT units for the purposes of selecting enemy units and determining the closest enemy unit. Being engaged solely with one or more AIRCRAFT units does not prevent a unit from being eligible to make a normal or advance move.",
      "transcription_sha256": "eb8485ee6333408f13c1bf413495a1d8015354241c7227ead66e60eefae61675",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.aircraft_rules:aircraft_movement_target_allowed",
        "warhammer40k_core.engine.aircraft_turn_end:aircraft_turn_end_binding",
        "warhammer40k_core.engine.movement_locks:movement_lock_reason"
      ]
    },
    {
      "source_id": "gw-11e-core-aircraft:shooting",
      "section_id": "23.03",
      "source_text": "The Plunging Fire rule (22.05) has no effect on attacks made by, or targeting, AIRCRAFT units.",
      "transcription_sha256": "dc06fda0e274db68edabf4a46469900c61ce025958c646139716b32a3d043dfe",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.shooting_targets:_plunging_fire_applies"
      ]
    },
    {
      "source_id": "gw-11e-core-aircraft:charging-and-fighting",
      "section_id": "23.04",
      "source_text": "AIRCRAFT units are not eligible to declare a charge, and can only make melee attacks that target FLYING units. Only FLYING units can select AIRCRAFT units as a charge target, and only FLYING models can make melee attacks that target AIRCRAFT units.",
      "transcription_sha256": "93567627909c8b3bdd8e086a2ecfd0d5b8f7fa648b948be874a100d0d6992271",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.charge_targets:charge_target_restriction",
        "warhammer40k_core.engine.aircraft_rules:aircraft_melee_target_allowed"
      ]
    }
  ],
