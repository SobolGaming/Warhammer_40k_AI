  "rule": {
    "rule_id": "13.09-hidden",
    "source_id": "gw-11e-app-core-rules-hidden-transcription-observed-2026-08-09:rule:13.09-hidden",
    "behavior_descriptor": "hidden_applies_in_light_or_dense_terrain_areas",
    "source_text": "A model is hidden while all of the following apply to it:\n\nThat model has the INFANTRY/BEASTS/SWARM keyword and is within a terrain area that contains one or more light/dense terrain features\nThat model's unit did not make one or more ranged attacks during this turn or during the previous turn. While a model is hidden, it can only be visible to enemy models that are within its detection range. Unless otherwise stated, a model's detection range is 15\".\n\nNOTE: During the first turn, conditions that require something not have happened during the previous turn are true. For the Hidden rule, this means that during the first turn a unit has not made ranged attacks during the previous turn.",
