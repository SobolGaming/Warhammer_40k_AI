  "source_version": "maintained-app-mirrors-observed-2026-09-06",
  "rules": [
    {
      "source_id": "gw-11e-core-unit-splitting:unit-splitting",
      "section_id": "01.02.06",
      "source_text": "Some rules allow you to split units into smaller units (e.g. the Transport ability of Drukhari Venoms). When using such rules:\nThe same models can only be subdivided in this way once (e.g. those smaller units cannot themselves be split further).\nIf a rule is used to split a unit into multiple units before the battle, the starting strength of each individual unit is changed to be equal to the number of models in that unit.",
      "transcription_sha256": "cfbc728ec6c5d07a9d6497db3f37754bb7b0c227d4194ee13a2e2f7cdf40793f",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.unit_splitting:build_split_army"
      ]
    },
    {
      "source_id": "gw-11e-core-unit-splitting:balanced-unit-splitting",
      "section_id": "01.02.06",
      "source_text": "A unit must be split into two units, each containing as equal a number of models as possible (when splitting a unit in this way, make a note of which models form each of the two new units). If a rule states a specific starting strength of the split units, but this is not possible based on the number of models in the unit being split (e.g. due to attached Leader/Support models), split the unit as stated above.",
      "transcription_sha256": "0c9515272839227cdd4070b2e7fca961f2892388992adf9db80c6345f667edca",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.unit_splitting:build_split_army"
      ]
    }
  ],
