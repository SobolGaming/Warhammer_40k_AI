  "rules": [
    {
      "source_id": "gw-11e-core-abilities:core:infiltrators",
      "section_id": "24.20",
      "source_text": "During deployment, if every model in a unit has this ability, it can be set up anywhere on the battlefield that is more than 8\" horizontally from your opponent’s deployment zone and all enemy units.",
      "transcription_sha256": "a38c1fea40ae417ef57a6a04a9440b0b745c13061ca58409fe4c0bb90f648258",
      "dependency_source_ids": [],
      "load_support_status": "loaded",
      "semantic_execution_status": "not_certified",
      "runtime_consumer_ids": []
    },
    {
      "source_id": "gw-11e-core-abilities:core:lone-operative",
      "section_id": "24.24",
      "source_text": "Unless part of an attached unit, this unit is not visible to enemy models unless they are within 12\" of this unit, and it cannot be targeted by [INDIRECT FIRE] weapons unless the attacking model is within 12\" of this unit.\n\nIf this ability takes the form Lone Operative X\", unless part of an attached unit, this unit is not visible to enemy models unless they are within X\" of this unit, and it cannot be targeted by [INDIRECT FIRE] weapons unless the attacking model is within X\" of this unit.",
      "transcription_sha256": "1932185d8939b87c944cf0325c76fde4b6cebe63643b53589764189a6f00078e",
      "dependency_source_ids": [],
      "load_support_status": "loaded",
      "semantic_execution_status": "not_certified",
      "runtime_consumer_ids": []
    },
    {
      "source_id": "gw-11e-core-abilities:core:scouts",
      "section_id": "24.31",
      "source_text": "This ability always takes the form Scouts X\". In the Resolve Pre‑battle Abilities step, if every model in a unit has this ability, you can do one of the following:\n\nIf that unit is in strategic reserves, you can set up that unit anywhere that is wholly within your deployment zone.\nIf that unit is wholly within your deployment zone, it can make a scout move (24.32).\nIf that unit is embarked within a DEDICATED TRANSPORT that is wholly within your deployment zone, and if every model embarked within that DEDICATED TRANSPORT has the Scouts ability, that DEDICATED TRANSPORT can make a scout move.",
      "transcription_sha256": "e031b0603c0345803a0fbe63f36f5994bd00c62706c45d8e491d1a1e4484fa87",
      "dependency_source_ids": [
        "gw-11e-core-abilities:core:scout-move"
      ],
      "load_support_status": "loaded",
      "semantic_execution_status": "not_certified",
      "runtime_consumer_ids": []
    },
    {
      "source_id": "gw-11e-core-abilities:core:scout-move",
      "section_id": "24.32",
      "source_text": "When eligible: It is the Resolve Pre-battle Abilities step, and your unit is wholly within your deployment zone. Maximum distance: The X\" in Scouts X\" Effect: Your unit moves as described in Moving (03). After moving: Your unit must be more than 8\" horizontally from all enemy units.",
      "transcription_sha256": "ff72b82ae24dbdc7c530bf08a6ae443017d9bb99d9f8a287b36cd0c2552354a7",
      "dependency_source_ids": [],
      "load_support_status": "loaded",
      "semantic_execution_status": "not_certified",
      "runtime_consumer_ids": []
    }
  ],
