  "rules": [
    {
      "source_id": "gw-11e-core-dice-results:highest-lowest",
      "section_id": "01.05.07",
      "source_text": "If a rule refers to the highest dice result and a dice roll involves multiple dice, if more than one of those dice have the same value, and that value is the highest, the active player must select one of those dice to be the highest dice result. If a rule refers to the lowest dice result and a dice roll involves multiple dice, if more than one of those dice have the same value, and that value is the lowest, the active player must select one of those dice to be the lowest dice result.",
      "transcription_sha256": "14241e9bcaf4daa1e7026903f99e2518dda542cc47c689129a50b4e51e696113",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.dice_extremum:request_dice_extremum"
      ]
    },
    {
      "source_id": "gw-11e-core-dice-results:treated-as-set-to",
      "section_id": "01.05.08",
      "source_text": "When a dice result is ‘treated as’ or 'set' to another value, any rules that would take effect if that value had been rolled take effect. This may result in a value that is greater than a value that could be rolled on a D6 dice.",
      "transcription_sha256": "5c562063cb3ab6245120e12cd9f6b7c6a2ab98fa84299929d6ae94b6ba99da37",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.core.dice:DiceRollState.with_result_override"
      ]
    },
