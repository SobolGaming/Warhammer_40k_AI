  "rules": [
    {
      "load_support_status": "loaded",
      "rule_id": "emergency-disembark-move",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.attack_sequence_destroyed_transport:_continue_pending_destroyed_transport_disembark",
        "warhammer40k_core.engine.attack_sequence_destroyed_transport:_request_destroyed_transport_disembark_placement",
        "warhammer40k_core.engine.emergency_disembark:apply_transport_hazard_mortal_wounds_service",
        "warhammer40k_core.engine.emergency_disembark:resolve_destroyed_transport_hazard_rolls_service"
      ],
      "section_heading": "EMERGENCY DISEMBARK MOVE",
      "section_id": "18.05",
      "semantic_execution_status": "executable_engine_runtime",
      "source_id": "gw-11e-core-rules:transports:emergency-disembark-move",
      "source_text": "EMERGENCY DISEMBARK MOVE\nWhen eligible: Your unit is embarked within a TRANSPORT model that was just destroyed.\nMaximum distance: SET-UP DISTANCE: 6\"\nEffect: Your unit is set up as described in Set Up (03.02)\nBefore moving: Make a hazard roll for each model in your unit (06.03)\nWhile moving: Set up each model in your unit:\n- Wholly within the set-up distance of that TRANSPORT, and as close as possible to that TRANSPORT.\n- Or: If the above is not possible while remaining unengaged, set up that model wholly within the set-up distance of that TRANSPORT, as close as possible to that TRANSPORT, and engaged.\nEach model that still cannot be set up is destroyed.\nAfter moving: Your unit is battle-shocked and, until the end of the turn, it is not eligible to declare a charge.",
      "transcription_sha256": "3d2ae5c7c61267b25d42f7139353d31528f5b4f7c66acbc63c64b596f3f8eb56"
    },
    {
      "load_support_status": "loaded",
      "rule_id": "assault-disembark-move",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.assault_disembark:assault_disembark_restriction_overrides",
        "warhammer40k_core.engine.phases.charge:_charge_unit_ineligibility_reason",
        "warhammer40k_core.engine.phases.movement_transports:_disembark_candidate_for_movement_unit",
        "warhammer40k_core.engine.transport_disembark_state:DisembarkedUnitState.for_mode",
        "warhammer40k_core.engine.transports:resolve_disembark"
      ],
      "section_heading": "ASSAULT DISEMBARK MOVE",
      "section_id": "18.06",
      "semantic_execution_status": "executable_engine_runtime",
      "source_id": "gw-11e-core-rules:transports:assault-disembark-move",
      "source_text": "ASSAULT DISEMBARK MOVE\nYour unit is set up as described in Set Up (Core Rules, 03.02). As stated in the rule allowing this move type, if all of the following apply to your unit: Embarked within a TRANSPORT model that is on the battlefield. Did not embark within that TRANSPORT this phase. That TRANSPORT has not made an advance/fall\u2011back move this phase. Set up each model in your unit wholly within the set\u2011up distance of that TRANSPORT. 3\" 18.06",
      "transcription_sha256": "93b5d311d7bce309e94f93c6b501a6980a820505786f59e0cb2bbfc6e53e4bee"
    },
    {
      "load_support_status": "loaded",
      "rule_id": "shock-disembark-move",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.shock_disembark:shock_disembark_restriction_overrides",
        "warhammer40k_core.engine.phases.movement_transports:_disembark_candidate_for_movement_unit",
        "warhammer40k_core.engine.transport_disembark_state:DisembarkedUnitState.for_mode",
        "warhammer40k_core.engine.transports:resolve_disembark",
        "warhammer40k_core.engine.phases.fight:FightPhaseHandler.advance_forced_fight_activations_if_needed"
      ],
      "section_heading": "SHOCK DISEMBARK MOVE",
      "section_id": "18.07",
      "semantic_execution_status": "executable_engine_runtime",
      "source_id": "gw-11e-core-rules:transports:shock-disembark-move",
      "source_text": "SHOCK DISEMBARK MOVE\nYour unit is set up as described in Set Up (Core Rules, 03.02). As stated in the rule allowing this move type, if all of the following apply to your unit: Embarked within a TRANSPORT model that is on the battlefield. Did not embark within that TRANSPORT this phase. Set up each model in your unit wholly within the set-up distance of that TRANSPORT. Each model that started this move engaged with an enemy unit must still be engaged with that enemy unit. If one or more enemy units engaged with your unit have not been selected to fight this phase, your opponent must select each of those units, one at a time; when each is selected, it becomes eligible to fight and is selected to fight. 3\" 18.07",
      "transcription_sha256": "d8dae354aabcc30c582b66e70939dd67c010055637f86923292c0c76ffe7252c"
    }
  ],
