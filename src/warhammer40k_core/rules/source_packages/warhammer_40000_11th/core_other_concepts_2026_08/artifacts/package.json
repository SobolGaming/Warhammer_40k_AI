      "section_heading": "VISIBILITY ANY-PART FAQ",
      "section_id": "06.01 FAQ",
      "semantic_execution_status": "executable_engine_runtime",
      "source_id": "gw-11e-core-rules:other-concepts:visibility-any-part-faq",
      "source_text": "When checking line of sight from one model to another, is this drawn between the bases of those models, or between any part of them?\nLine of sight is drawn from any part of the observing model to any part of the model being observed.",
      "transcription_sha256": "7ad46ec389adfa76cc3d0e3d763f6237835ae60a4264fbca52d48a97b79911ed"
