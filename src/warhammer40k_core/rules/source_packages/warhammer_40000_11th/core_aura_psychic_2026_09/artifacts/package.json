  "rules": [
    {
      "source_id": "gw-11e-core-aura-psychic:aura-abilities",
      "section_id": "22.01",
      "source_text": "Abilities that affect models or units within a stated range are aura abilities, and are tagged with the word ‘Aura’.\nWhile a model with an aura ability is on the battlefield, it is always within range of its own aura ability.\nA unit can be affected by more than one aura ability at a time, but if a unit is within range of the same aura ability more than once, that aura ability only applies to that unit once.",
      "transcription_sha256": "930015bed3490c7c24cf3e3952d925a17dd6144874dc9a56c2ab68d3fd452b60",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.rule_aura_resolution:aura_affected_unit_ids",
        "warhammer40k_core.engine.aura_applications:non_stacking_aura_applications"
      ]
    },
    {
      "source_id": "gw-11e-core-aura-psychic:psychic-abilities-with-a-psychic-level",
      "section_id": "22.03.01",
      "source_text": "When using psychic abilities with a psychic level, a PSYKER unit cannot use the same psychic ability more than once per phase.",
      "transcription_sha256": "e94feeb3d390500884ff9ceba0c0717087303e578d182efa444a7ad1f41906c4",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
