      ]
    },
    {
      "source_id": "gw-11e-core-fight:consolidate-step",
      "section_id": "12.07",
      "source_text": "Both players make consolidation moves (12.08) with all of their eligible units they choose to move. The ‘Eligible If’ section describes which units are eligible to make such moves. The player whose turn it is resolves all of their moves first, followed by their opponent. Each unit cannot make more than one consolidation move during this step.",
      "transcription_sha256": "4e538c9393f4a2d434ef61e4657be18687b4f45c5b20729015f97721c5a0ca0b",
      "load_support_status": "loaded",
      "semantic_execution_status": "executable_engine_runtime",
      "runtime_consumer_ids": [
        "warhammer40k_core.engine.phases.fight:FightPhaseHandler"
      ]
    }
