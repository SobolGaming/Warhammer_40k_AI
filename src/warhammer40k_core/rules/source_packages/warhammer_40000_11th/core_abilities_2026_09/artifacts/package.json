        "warhammer40k_core.engine.prebattle_alternation:validate_prebattle_alternation_restore",
        "warhammer40k_core.engine.prebattle_records:PreBattleAlternationCursor",
        "warhammer40k_core.engine.setup_flow:SetupFlow._advance_resolve_prebattle_actions"
      ],
      "runtime_handler_id": "core:scouts",
      "section_heading": "ALTERNATING SCOUT MOVES",
      "section_id": "FAQ",
      "semantic_execution_status": "executable_engine_runtime",
      "source_id": "gw-11e-core-abilities:faq:alternating-scout-moves",
      "source_text": "If both players have units with the Scouts ability, do they alternate resolving scout moves?\nYes, players alternate resolving any pre-battle rules units from their army may have, starting with the player who will take the first turn.",
      "transcription_sha256": "e2e4740b73d2ea159eecb42da7246c399dc157bef038a623f9ecd94d07ba1296",
      "trigger_kind": "before_battle",
      "when_descriptor": "If both players have units with pre-battle rules to resolve"
    },
    {
      "effect_descriptor": "make a number of hazard rolls for that unit equal to the number of Hazardous weapons selected in the Select Weapons step",
      "load_support_status": "loaded",
      "restrictions_descriptor": "each selected physical Hazardous weapon instance contributes one roll; make all hazard rolls simultaneously under 06.03",
      "rule_id": "hazardous",
      "runtime_ability_id": "core-hazardous",
